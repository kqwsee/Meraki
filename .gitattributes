# Store text files with LF in the repository regardless of each developer's OS settings,
# so Windows (CRLF) checkouts don't show every line as changed.
* text=auto
# shell hooks must keep LF or sh fails on Windows checkouts
.githooks/* text eol=lf
*.sh text eol=lf
# cmd.exe misreads labels and goto in LF-only batch files
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.wasm binary
*.onnx binary
