# Copy to .env and adjust.
SECRET_KEY=change-me

# --- LLM ---
# claude_cli: uses your Claude subscription through the locally logged-in Claude Code CLI (`claude`)
LLM_PROVIDER=claude_cli
LLM_MODEL_FAST=haiku
LLM_MODEL_SMART=sonnet
CLAUDE_EFFORT=low
# CLAUDE_CLI_PATH=

# openai: any OpenAI-compatible endpoint (OpenAI, OpenRouter, Ollama http://localhost:11434/v1, LM Studio...)
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# LLM_MODEL_FAST=gpt-4o-mini
# LLM_MODEL_SMART=gpt-4o

# --- Memory ---
MEMORY_BACKEND=mempalace

# --- Material import by URL ---
# Public address of this instance and an optional contact (Wikimedia requires a descriptive User-Agent)
PUBLIC_URL=http://localhost:5173
# FETCH_CONTACT=admin@example.org
